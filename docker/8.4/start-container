#!/usr/bin/env bash

if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sail" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sail' or 'root'."
    exit 1
fi

if [ ! -z "$WWWUSER" ]; then
    usermod -u $WWWUSER sail
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R ugo+rw /.composer

# Fix storage directory permissions for Laravel
if [ -d /var/www/html/storage ]; then
    chown -R sail:sail /var/www/html/storage
    chmod -R 775 /var/www/html/storage
    # Ensure logs directory exists and is writable
    mkdir -p /var/www/html/storage/logs
    chown -R sail:sail /var/www/html/storage/logs
    chmod -R 775 /var/www/html/storage/logs
    # Ensure framework directories are writable
    mkdir -p /var/www/html/storage/framework/{cache,sessions,views,testing}
    chown -R sail:sail /var/www/html/storage/framework
    chmod -R 775 /var/www/html/storage/framework
fi

if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu $WWWUSER "$@"
    fi
else
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
